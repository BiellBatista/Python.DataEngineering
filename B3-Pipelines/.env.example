# Docker Compose substitui esses valores com o arquivo .env local.
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=replace-with-url-safe-password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-strong-password

# Caminho do data lake no host; ambos os serviços o montam em /data-lake.
B3_DATA_LAKE_ROOT=/caminho/para/seu/b3_datalake

# Gere um token aleatório e exclusivo para este ambiente.
QUACK_TOKEN=replace-with-a-long-random-token
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4
BRONZE_MAX_WORKERS=4
DUCKDB_PORT=9494

B3_START_YEAR=2024
B3_END_YEAR=2025
