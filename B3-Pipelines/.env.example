# Docker Compose substitui esses valores com o arquivo .env local.
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
GRAFANA_PORT=3000
AIRFLOW_BASE_IMAGE=apache/airflow:3.3.1-python3.12
DUCKDB_BASE_IMAGE=python:3.15-slim
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-long-random-secret
AIRFLOW_DB_PASSWORD=replace-with-url-safe-password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-strong-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

# Caminho do data lake no host.
# Containers Airflow e duckdb-server montam em /data-lake.
B3_DATA_LAKE_ROOT=/caminho/para/seu/b3_datalake
B3_DOCKER_NETWORK=b3-pipelines_airflow_network

# Gere um token aleatório e exclusivo para este ambiente.
QUACK_TOKEN=replace-with-a-long-random-token
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4
BRONZE_MAX_WORKERS=4
DUCKDB_HOST=duckdb-server
DUCKDB_PORT=9494

B3_START_YEAR=2024
B3_END_YEAR=2025
